{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/i/:id", "destination": "/go" },
    { "source": "/g/:code", "destination": "/go" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
